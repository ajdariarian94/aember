# Max line length before warnings
linelength = 80

# Encourage breaking long argument lists
max_arguments = 3

# Allow dangling closing parentheses on new lines
dangle_parens = True

# -----------------------------------------------------------------------------
# Enable all checks, then optionally disable noisy ones
# -----------------------------------------------------------------------------

filter = +all

# Example: disable rules you might not care about
# (uncomment if needed)
# filter = -convention/filename
# filter = -readability/wonkycase
# filter = -package/stdargs