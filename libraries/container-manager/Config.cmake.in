@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(aember-libs REQUIRED COMPONENTS utils)

# Reconstruct lxc imported target for consumers
find_package(PkgConfig REQUIRED)
pkg_check_modules(LXC REQUIRED lxc)   # no IMPORTED_TARGET here

if(NOT TARGET PkgConfig::LXC)
    add_library(PkgConfig::LXC INTERFACE IMPORTED)
    set_target_properties(PkgConfig::LXC PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${LXC_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES      "${LXC_LINK_LIBRARIES}"
        INTERFACE_COMPILE_OPTIONS     "${LXC_CFLAGS_OTHER}"
    )
endif()

include(${CMAKE_CURRENT_LIST_DIR}/${COMPONENT}Targets.cmake)
