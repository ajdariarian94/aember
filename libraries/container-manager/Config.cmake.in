@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(aember-libs REQUIRED COMPONENTS mount-manager utils)

# Reconstruct LXC imported target for consumers
set(LXC_INCLUDE_DIR "/aember_ws/aember/yocto/build/@ARCHITECTURE@/virtualization/include")
set(LXC_LIBRARY "/aember_ws/aember/yocto/build/@ARCHITECTURE@/virtualization/libs/liblxc.so")

if(NOT TARGET LXC::LXC)
    add_library(LXC::LXC SHARED IMPORTED)
    set_target_properties(LXC::LXC PROPERTIES
        IMPORTED_LOCATION "${LXC_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${LXC_INCLUDE_DIR}"
    )
endif()

include(${CMAKE_CURRENT_LIST_DIR}/${COMPONENT}Targets.cmake)