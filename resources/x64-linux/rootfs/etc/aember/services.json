{
  "services": [
    {
      "name": "echo-aember",
      "type": "process",
      "command": "/usr/bin/echo-aember",
      "args": [""],
      "working_directory": "",
      "environment": {},
      "restart_policy": "always",
      "dependencies": [],
      "max_restart_attempts": 5,
      "restart_delay": 5
    },
    {
      "name": "alpine-echo",
