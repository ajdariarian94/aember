        "rootfs": "/var/lib/aember/containers/alpine",
        "args": ["/echo-alpine.sh"]
      },
      "restart_policy": "always",
      "dependencies": [],
      "max_restart_attempts": 5,
      "restart_delay": 5
    }
  ]
}