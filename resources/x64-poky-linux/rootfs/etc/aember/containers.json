{
  "containers": [
    {
      "name": "aember-monitor",
      "type": "container",
      "container": {
        "squashfs": "/var/lib/aember/aember-monitor/aember-monitor.squashfs",
        "rootfs": "/var/lib/aember/containers/aember-monitor",
        "config_path": "/var/lib/aember/aember-monitor/lxc.container.conf",
        "args": ["/usr/bin/aember-monitor", "-platform", "linuxfb"]
      },
      "restart_policy": "always",
      "dependencies": [],
      "max_restart_attempts": 5,
      "restart_delay": 5
    }
  ]
}