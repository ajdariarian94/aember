#!/bin/sh

case "$1" in
    deconfig)
        ip route flush dev $interface 2>/dev/null
        ip addr flush dev $interface 2>/dev/null
        ;;

    bound|renew)
        ip link set $interface up

        # Flush old state
        ip route flush dev $interface 2>/dev/null
        ip addr flush dev $interface 2>/dev/null

        # Add address — this also creates the connected subnet route automatically
        ip addr add $ip/24 dev $interface

        # Now the subnet route exists, default gw will work
        ip route add default via $router 2>/dev/null

        # DNS
        if [ -n "$dns" ]; then
            printf "" > /etc/resolv.conf
            for d in $dns; do
                printf "nameserver %s\n" "$d" >> /etc/resolv.conf
            done
        fi
        ;;

    leasefail|nak)
        echo "udhcpc: failed to get lease on $interface"
        ;;
esac

exit 0