# DRAFT, not enabled: CLA Assistant (contributor-assistant/github-action).
# To enable after legal review: publish CLA-DRAFT.md's final text (e.g. as
# CLA.md on main), move this file to .github/workflows/cla.yml, and pin the
# action to a full commit SHA instead of the tag.
name: CLA
on:
  issue_comment:
    types: [created]
  pull_request_target:
    types: [opened, synchronize, closed]
permissions:
  actions: write
  contents: write      # stores signatures in signatures/cla.json on a branch
  pull-requests: write
  statuses: write
jobs:
  cla:
    runs-on: ubuntu-24.04
    if: >-
      (github.event.comment.body == 'recheck' ||
       github.event.comment.body == 'I have read the CLA Document and I hereby sign the CLA') ||
      github.event_name == 'pull_request_target'
    steps:
      - uses: contributor-assistant/github-action@v2.6.1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          path-to-document: https://github.com/ajdariarian94/aember/blob/main/CLA.md
          path-to-signatures: signatures/cla.json
          branch: cla-signatures
          allowlist: ajdariarian94,dependabot[bot]
