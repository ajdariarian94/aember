BasedOnStyle: Google
ColumnLimit: 80
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Always
AllowShortLambdasOnASingleLine: All
AllowShortLoopsOnASingleLine: true

DerivePointerAlignment: false
PointerAlignment: Left

# ---------------------------------------------------------------------------
# Include ordering:
#   1. aember-libs headers
#   2. third-party headers (nlohmann, spdlog, etc.)
#   3. C++ standard library headers
#   4. C system headers
# ---------------------------------------------------------------------------
IncludeCategories:
  - Regex:    '^<aember-libs/'
    Priority: 1
    SortPriority: 1
  - Regex:    '^<(nlohmann|spdlog|CLI|meta)/'
    Priority: 2
    SortPriority: 2
  - Regex:    '^<[a-z_]+>'
    Priority: 3
    SortPriority: 3
  - Regex:    '^<[a-z_/]+\.h>'
    Priority: 4
    SortPriority: 4

BinPackArguments: false
InsertNewlineAtEOF: true